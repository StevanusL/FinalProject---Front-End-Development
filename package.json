{
  "name": "paketku-unklab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sistem penerimaan dan pengambilan paket kurir di lingkungan UNKLAB, dengan AI pembaca label (Gemini).",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:server\" \"npm:client\"",
