# Salin file ini menjadi ".env" lalu isi nilainya.

# ---------- Gemini (AI) ----------
# API key dari https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- Alamat server lokal ----------
VITE_API_URL=http://localhost:3001
VITE_MAIL_URL=http://localhost:3002

# ---------- Email Gmail (notifikasi paket tiba) ----------
# PENTING: variabel di bawah ini TIDAK diawali VITE_, supaya tidak pernah terkirim ke browser.
# GMAIL_APP_PASSWORD adalah App Password 16 huruf, BUKAN kata sandi Gmail biasa.
# Buat di https://myaccount.google.com/apppasswords (Verifikasi 2 Langkah harus aktif).
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=PaketKu UNKLAB
MAIL_SERVER_PORT=3002
# Alamat aplikasi untuk tautan "Buka PaketKu" di email
APP_URL=http://localhost:5173
